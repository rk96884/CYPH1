---
import "../styles/tokens.css";
import "../styles/global.css";
import { brand } from "../data/brand";
import { withBase } from "../utils/base-path";
interface Props { title?: string; description?: string; robots?: string; structuredData?: Record<string, unknown> | Record<string, unknown>[]; }
const {
  title = `${brand.name} — ${brand.proposition}`,
  description = "CYPH/1 is premium at-home beauty technology, informed by the hair-growth cycle. Join early access.",
  robots = "index, follow",
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/brand/social/cyph1-social-card.png", Astro.site);
const favicon = withBase("brand/generated/cyph1-favicon.svg");
const michromaFont = withBase("fonts/michroma-latin.woff2");
const manropeFont = withBase("fonts/manrope-latin.woff2");
const fontFaces = `@font-face{font-family:Michroma;src:url("${michromaFont}") format("woff2");font-style:normal;font-weight:400;font-display:swap}@font-face{font-family:Manrope;src:url("${manropeFont}") format("woff2");font-style:normal;font-weight:400 600;font-display:swap}`;
---
<!doctype html><html lang="en-GB"><head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="robots" content={robots}/><meta name="theme-color" content="#080711"/>
  <link rel="icon" href={favicon} type="image/svg+xml"/><link rel="preload" href={michromaFont} as="font" type="font/woff2" crossorigin/><link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin/><style is:global set:html={fontFaces}/>
  <link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={brand.name}/><meta property="og:locale" content="en_GB"/><meta property="og:image" content={socialImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="CYPH/1 — Target the growth. At-home IPL, informed by the hair-growth cycle."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content="CYPH/1 — Target the growth. At-home IPL, informed by the hair-growth cycle."/><title>{title}</title>
  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/>} 
</head><body><a class="skip-link" href="#main">Skip to content</a><slot/>
  <style is:global>
    .cyph-analytics-consent{position:fixed;bottom:1rem;left:1rem;right:1rem;z-index:9999;max-width:34rem;margin-inline:auto;padding:1rem 1.25rem;background:#171323;color:#fff;border:1px solid #827b9a;border-radius:12px;box-shadow:0 8px 32px #0008;font:inherit}
    .cyph-analytics-consent p{margin:0 0 .75rem;line-height:1.5}
    .cyph-analytics-consent a{color:#d8c4ff;text-decoration:underline}
    .cyph-analytics-consent .actions{display:flex;gap:.75rem;flex-wrap:wrap}
    .cyph-analytics-consent button{cursor:pointer;border:1px solid #a99aca;border-radius:6px;padding:.55rem .9rem;background:#332b49;color:#fff;font:inherit}
    .cyph-analytics-consent button:first-child{background:#e3c9ff;color:#171323}
  </style>
  <div class="cyph-analytics-consent" id="cyph-analytics-consent" role="region" aria-label="Analytics cookie choices" hidden>
    <p>Can we use optional Google Analytics cookies to understand which pages visitors find useful? You can change your choice at any time. See our <a href={withBase("privacy/")}>Privacy Notice</a>.</p>
    <div class="actions"><button type="button" data-analytics-choice="accept">Accept analytics</button><button type="button" data-analytics-choice="reject">Reject analytics</button></div>
  </div>
  <script is:inline define:vars={{ measurementId: "G-SVG4X321T9" }}>
    (() => {
      const banner = document.getElementById("cyph-analytics-consent");
      const settings = document.getElementById("cyph-analytics-settings");
      if (!banner) return;
      const key = "cyph1_analytics_consent_v1";
      const exclusionKey = "cyph1_analytics_excluded_v1";
      const url = new URL(location.href);
      const exclusionCommand = url.searchParams.get("internal_analytics");
      if (exclusionCommand === "off" || exclusionCommand === "on") {
        try {
          if (exclusionCommand === "off") localStorage.setItem(exclusionKey, "true");
          else localStorage.removeItem(exclusionKey);
        } catch (_) { /* storage may be unavailable */ }
        url.searchParams.delete("internal_analytics");
        history.replaceState(history.state, "", url.pathname + url.search + url.hash);
      }
      let excluded = false;
      try { excluded = localStorage.getItem(exclusionKey) === "true"; } catch (_) { /* storage unavailable */ }
      const isProduction = location.hostname === "www.cyph1.co.uk" || location.hostname === "cyph1.co.uk";
      let choice = null;
      try { choice = localStorage.getItem(key); } catch (_) { /* storage may be unavailable */ }
      let started = false;
      function startAnalytics() {
        if (started || !isProduction || excluded) return;
        started = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", measurementId, { send_page_view: true });
        const tag = document.createElement("script");
        tag.async = true;
        tag.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(measurementId);
        document.head.appendChild(tag);
      }
      function update(value) {
        choice = value;
        try { localStorage.setItem(key, value); } catch (_) { /* session-only choice */ }
        banner.hidden = true;
        if (value === "accept") startAnalytics();
        else if (started) location.reload();
      }
      if (choice === "accept") startAnalytics();
      else if (choice !== "reject" && !excluded) banner.hidden = false;
      banner.querySelectorAll("[data-analytics-choice]").forEach((button) => {
        button.addEventListener("click", () => update(button.getAttribute("data-analytics-choice")));
      });
      settings?.addEventListener("click", () => { banner.hidden = false; banner.querySelector("button")?.focus(); });
    })();
  </script>
</body></html>
