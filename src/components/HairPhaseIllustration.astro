---
interface Props { phase: "Anagen" | "Catagen" | "Telogen" | "Exogen"; }
const { phase } = Astro.props;
const states = {
  Anagen: { follicleBottom: 92, bulbY: 91, strandTop: 8, papillaY: 97, detached: false },
  Catagen: { follicleBottom: 78, bulbY: 76, strandTop: 12, papillaY: 93, detached: false },
  Telogen: { follicleBottom: 65, bulbY: 63, strandTop: 10, papillaY: 90, detached: false },
  Exogen: { follicleBottom: 70, bulbY: 68, strandTop: -8, papillaY: 94, detached: true },
} as const;
const state = states[phase];
const strandStart = state.detached ? 40 : state.bulbY;
---
<svg class="phase-illustration" viewBox="0 0 180 128" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`skin-${phase}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5a376d"/><stop offset="1" stop-color="#281733"/></linearGradient>
    <linearGradient id={`hair-${phase}`} x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#9b6a35"/><stop offset="1" stop-color="#e6c685"/></linearGradient>
  </defs>
  <path class="skin-cutaway" fill={`url(#skin-${phase})`} d="M14 40 Q28 29 47 34 Q66 39 90 34 Q114 29 133 34 Q152 39 166 40 L166 93 Q162 116 139 120 L41 120 Q18 116 14 93 Z"/>
  <path class="epidermis" d="M15 41 Q30 31 48 36 Q67 41 90 36 Q113 31 132 36 Q150 41 165 41"/>
  <path class="follicle" d={`M82 39 C76 54 73 ${state.follicleBottom - 13} 77 ${state.follicleBottom} C80 ${state.follicleBottom + 9} 94 ${state.follicleBottom + 9} 98 ${state.follicleBottom} C102 ${state.follicleBottom - 13} 99 54 94 39`}/>
  <path class="hair-fill" fill={`url(#hair-${phase})`} d={`M86 ${strandStart} C85 57 91 24 111 ${state.strandTop} C96 29 90 58 91 ${strandStart} Z`}/>
  <ellipse class="hair-bulb" cx="88" cy={state.bulbY} rx={phase === "Anagen" ? 9 : 6} ry={phase === "Anagen" ? 8 : 5}/>
  <path class="gland" d="M76 51 C65 43 58 49 60 56 C65 55 71 56 77 61"/>
  <path class="vessel vessel-one" d="M37 108 C48 94 57 102 67 90"/><path class="vessel vessel-two" d="M143 108 C132 94 122 102 110 90"/>
  <path class="papilla" d={`M84 ${state.papillaY + 4} Q88 ${state.papillaY - 5} 92 ${state.papillaY + 4}`}/>
  {state.detached && <path class="shed-motion" d="M116 12 Q126 6 135 4"/>}
  <line class="diagram-rule" x1="24" y1="121" x2="156" y2="121"/>
</svg>

