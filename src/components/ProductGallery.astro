---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { productGallery } from "../data/launch-product";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/products/ipl/*.{webp,png}", { eager: true });
const heroSizes = "(min-width: 1392px) 657px, (min-width: 960px) 48vw, 92vw";
const thumbnailSizes = "(min-width: 960px) 110px, (min-width: 500px) 100px, 25vw";
const gallery = await Promise.all(productGallery.map(async item => {
  const asset = images[`../assets/products/ipl/${item.filename}`]?.default;
  if (!asset) return { ...item, asset: undefined, full: undefined, display: undefined, srcset: "" };
  const full = await getImage({ src: asset, width: asset.width, format: "webp" });
  const widths = [...new Set([320, 480, 640, 960, 1280, asset.width].filter(width => width <= asset.width))].sort((a,b) => a-b);
  const variants = await Promise.all(widths.map(width => getImage({ src: asset, width, format: "webp" })));
  const display = variants.find((_, i) => (widths[i] ?? 0) >= 640) ?? variants.at(-1);
  if (!display) return { ...item, asset: undefined, full: undefined, display: undefined, srcset: "" };
  return { ...item, asset, full, display, srcset: variants.map((v,i) => `${v.src} ${widths[i]}w`).join(", ") };
}));
const first = gallery.find(item => item.asset && item.display && item.full);
---
<div class="gallery-shell" data-product-gallery aria-label="CYPH/1 product images">
  {first ? (
    <>
      <figure class="gallery-main">
        <a class="gallery-main-link" data-gallery-full href={first.full!.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size image: ${first.label} (new tab)`}>
          <img data-gallery-main src={first.display!.src} srcset={first.srcset} sizes={heroSizes} alt={first.alt} width={first.asset!.width} height={first.asset!.height} loading="eager" fetchpriority="high" decoding="async" />
        </a>
        <figcaption data-gallery-caption aria-live="polite" aria-atomic="true">{first.label}</figcaption>
      </figure>
      <div class="gallery-selector" role="group" aria-label="Choose a product image">
        {gallery.map((item, index) => item.asset && item.display && item.full ? (
          <button
            class="gallery-choice"
            type="button"
            data-gallery-choice
            data-gallery-src={item.display.src}
            data-gallery-srcset={item.srcset}
            data-gallery-full-src={item.full.src}
            data-gallery-alt={item.alt}
            data-gallery-label={item.label}
            data-gallery-width={item.asset.width}
            data-gallery-height={item.asset.height}
            aria-label={`Show image ${index + 1}: ${item.label}`}
            aria-pressed={item.key === first.key ? "true" : "false"}
          >
            <Image src={item.asset} alt={item.alt} width={Math.min(320, item.asset.width)} widths={[...new Set([120, 240, Math.min(320, item.asset.width)].filter(width => width <= item.asset!.width))]} sizes={thumbnailSizes} loading="lazy" />
            <span class="gallery-choice-label">{item.label}</span>
          </button>
        ) : null)}
      </div>
      <p class="gallery-hint">Select a thumbnail to change the image. Select the large image to open it at full size.</p>
    </>
  ) : <div class="gallery-placeholder"><p>Product images coming soon</p></div>}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach(shell => {
    const main = shell.querySelector<HTMLImageElement>("[data-gallery-main]");
    const full = shell.querySelector<HTMLAnchorElement>("[data-gallery-full]");
    const caption = shell.querySelector<HTMLElement>("[data-gallery-caption]");
    const choices = [...shell.querySelectorAll<HTMLButtonElement>("[data-gallery-choice]")];
    if (!main || !full || !caption || !choices.length) return;
    const select = (choice: HTMLButtonElement) => {
      if (choice.getAttribute("aria-pressed") === "true") return;
      // Clear the old responsive candidates before assigning the new image.
      main.removeAttribute("srcset");
      main.src = choice.dataset.gallerySrc ?? "";
      main.srcset = choice.dataset.gallerySrcset ?? "";
      main.alt = choice.dataset.galleryAlt ?? "";
      main.width = Number(choice.dataset.galleryWidth) || main.width;
      main.height = Number(choice.dataset.galleryHeight) || main.height;
      full.href = choice.dataset.galleryFullSrc ?? main.src;
      const label = choice.dataset.galleryLabel ?? "Product image";
      full.setAttribute("aria-label", `Open full-size image: ${label} (new tab)`);
      caption.textContent = label;
      choices.forEach(button => button.setAttribute("aria-pressed", String(button === choice)));
    };
    choices.forEach((choice, index) => {
      choice.addEventListener("click", () => select(choice));
      choice.addEventListener("keydown", event => {
        if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? choices.length - 1 : (index + (event.key === "ArrowRight" ? 1 : -1) + choices.length) % choices.length;
        const nextChoice = choices[next];
        if (!nextChoice) return;
        nextChoice.focus();
        select(nextChoice);
      });
    });
  });
</script>
