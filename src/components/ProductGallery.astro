---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { productGallery } from "../data/launch-product";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/products/ipl/*.{webp,png}", { eager: true });
const heroSizes = "(min-width: 1392px) 657px, (min-width: 960px) 48vw, 92vw";
const thumbnailSizes = "(min-width: 960px) 16vw, (min-width: 500px) 30vw, 45vw";
const gallery = await Promise.all(productGallery.map(async item => {
  const asset = images[`../assets/products/ipl/${item.filename}`]?.default;
  if (!asset) return { ...item, asset: undefined, full: undefined, display: undefined, srcset: "" };
  const full = await getImage({ src: asset, width: asset.width, format: "webp" });
  const widths = [...new Set([320, 480, 640, 960, 1280, asset.width].filter(width => width <= asset.width))].sort((a,b) => a-b);
  const variants = await Promise.all(widths.map(width => getImage({ src: asset, width, format: "webp" })));
  const display = variants.find((_, i) => (widths[i] ?? 0) >= 640) ?? variants.at(-1);
  if (!display) return { ...item, asset: undefined, full: undefined, display: undefined, srcset: "" };
  return { ...item, asset, full, display, srcset: variants.map((v,i) => `${v.src} ${widths[i]}w`).join(", ") };
}));
const first = gallery.find(item => item.asset && item.display && item.full);
const secondary = gallery.filter(item => item.key !== first?.key && item.asset && item.display && item.full);
---
<div class="gallery-shell" data-product-gallery aria-label="CYPH/1 product images">
  {first ? (
    <>
      <figure class="gallery-main">
        <a class="gallery-main-link" data-gallery-full href={first.full!.src} aria-label={`Open image gallery: ${first.label}`}>
          <img src={first.display!.src} srcset={first.srcset} sizes={heroSizes} alt={first.alt} width={first.asset!.width} height={first.asset!.height} loading="eager" fetchpriority="high" decoding="async" />
        </a>
        <figcaption data-gallery-caption aria-live="polite" aria-atomic="true">{first.label}</figcaption>
      </figure>
      <div class="gallery-selector" role="group" aria-label="Choose a product image">
        {secondary.map((item, index) => item.asset && item.display && item.full ? (
          <button
            class="gallery-choice"
            type="button"
            data-gallery-choice
            data-gallery-index={index + 1}
            data-gallery-full-src={item.full.src}
            data-gallery-alt={item.alt}
            data-gallery-label={item.label}
            aria-label={`Open image gallery at ${item.label}`}
          >
            <Image src={item.asset} alt={item.alt} width={Math.min(320, item.asset.width)} widths={[...new Set([120, 240, Math.min(320, item.asset.width)].filter(width => width <= item.asset!.width))]} sizes={thumbnailSizes} loading="lazy" />
            <span class="gallery-choice-label">{item.label}</span>
          </button>
        ) : null)}
      </div>
      <p class="gallery-hint">Select any thumbnail to open the gallery. Use the arrows to browse all images.</p>
    </>
  ) : <div class="gallery-placeholder"><p>Product images coming soon</p></div>}
  <dialog class="gallery-lightbox" data-gallery-lightbox aria-label="Product image gallery">
    <div class="gallery-lightbox-inner">
      <button type="button" class="gallery-lightbox-close" data-gallery-lightbox-close aria-label="Close image gallery">×</button>
      <div class="gallery-lightbox-stage"><button type="button" class="gallery-lightbox-arrow" data-gallery-prev aria-label="Previous image">‹</button>
      <img data-gallery-lightbox-image src={first?.full?.src ?? ""} alt={first?.alt ?? "Product image"} width={first?.asset?.width ?? 1} height={first?.asset?.height ?? 1} loading="lazy" />
      <button type="button" class="gallery-lightbox-arrow" data-gallery-next aria-label="Next image">›</button></div>
      <p data-gallery-lightbox-caption>{first?.label ?? ""}</p>
    </div>
  </dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach(shell => {
    const full = shell.querySelector<HTMLAnchorElement>("[data-gallery-full]");
    const choices = [...shell.querySelectorAll<HTMLButtonElement>("[data-gallery-choice]")];
    const dialog = shell.querySelector<HTMLDialogElement>("[data-gallery-lightbox]");
    const image = dialog?.querySelector<HTMLImageElement>("[data-gallery-lightbox-image]");
    const caption = dialog?.querySelector<HTMLElement>("[data-gallery-lightbox-caption]");
    const close = dialog?.querySelector<HTMLButtonElement>("[data-gallery-lightbox-close]");
    const prev = dialog?.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = dialog?.querySelector<HTMLButtonElement>("[data-gallery-next]");
    if (!full || !dialog || !image || !caption || !close || !prev || !next) return;
    const slides = [
      { src: full.href, alt: full.querySelector("img")?.alt ?? "CYPH/1 IPL device", label: "Primary Product Hero" },
      ...choices.map(choice => ({
        src: choice.dataset.galleryFullSrc ?? "",
        alt: choice.dataset.galleryAlt ?? "CYPH/1 product image",
        label: choice.dataset.galleryLabel ?? "Product image",
      })),
    ];
    let current = 0;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      if (!slide) return;
      image.src = slide.src;
      image.alt = slide.alt;
      caption.textContent = `${slide.label} · ${current + 1} of ${slides.length}`;
    };
    const open = (index: number) => {
      if (typeof dialog.showModal !== "function") return;
      show(index);
      dialog.showModal();
      close.focus();
    };
    full.addEventListener("click", event => { event.preventDefault(); open(0); });
    choices.forEach((choice, index) => choice.addEventListener("click", () => open(index + 1)));
    prev.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));
    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("keydown", event => {
      if (event.key === "ArrowLeft") { event.preventDefault(); show(current - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); show(current + 1); }
    });
  });
</script>
