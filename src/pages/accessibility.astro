---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Accessibility Statement — CYPH/1" description="Read how CYPH/1 approaches accessible design, keyboard use, readable contrast, responsive layouts and reduced motion.">
  <Header/>
  <main id="main" class="legal-page">
    <div class="container prose">
      <p class="eyebrow">Site information</p>
      <h1>Accessibility</h1>
      <p>We want the CYPH/1 website to be usable by as many people as possible. The site is being developed towards WCAG 2.2 Level AA.</p>
      <h2>Our approach</h2>
      <p>We use semantic structure, keyboard-accessible controls, visible focus states, readable contrast, reduced-motion support and responsive layouts.</p>
      <h2>Feedback</h2>
      <p>If you experience an accessibility barrier, email <a href="mailto:info@cyph1.co.uk">info@cyph1.co.uk</a>. Please describe the page and what you were trying to do so we can investigate.</p>
      <p>Last updated: 21 August 2026.</p>
    </div>
  </main>
  <Footer/>
</BaseLayout>

