import BaseLayout from "../layouts/BaseLayout.astro"; import Header from "../components/Header.astro"; import Footer from "../components/Footer.astro";
---
<BaseLayout title="Accessibility — CYPH/1" description="The accessibility approach for the CYPH/1 website."><Header/><main id="main" class="legal-page"><div class="container prose"><p class="eyebrow">Site information</p><h1>Accessibility</h1><p>We want the CYPH/1 website to be usable by as many people as possible. The site is being developed towards WCAG 2.2 Level AA.</p><h2>Our approach</h2><p>We use semantic structure, keyboard-accessible controls, visible focus states, readable contrast, reduced-motion support and responsive layouts.</p><h2>Feedback</h2><p>Contact details for accessibility feedback will be added before the public launch.</p><p>Last updated: 19 August 2026.</p></div></main><Footer/></BaseLayout>
