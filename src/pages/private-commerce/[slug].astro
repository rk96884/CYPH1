---
import { countryCodes, importChargesNotice } from "../../../packages/commerce-core/src/countries";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandMark from "../../components/BrandMark.astro";
import { privateCommercePresentation } from "../../config/private-commerce";

export function getStaticPaths() {
  const presentation = privateCommercePresentation();
  return presentation ? [{ params: { slug: presentation.productSlug }, props: { presentation } }] : [];
}

const { presentation } = Astro.props;
const names = new Intl.DisplayNames(["en-GB"], { type: "region" });
const countries = countryCodes.map(code => ({ code, name: names.of(code) ?? code })).sort((a, b) => a.name.localeCompare(b.name, "en-GB"));
---
<BaseLayout title={`Private checkout test — ${presentation.productName}`} description="Private CYPH/1 test checkout." robots="noindex, nofollow, noarchive">
  <header class="private-header container"><BrandMark/><span>Private test environment</span></header>
  <main id="main" class="private-commerce container">
    <section aria-labelledby="private-product-title">
      <p class="eyebrow">Internal integration test</p>
      <h1 id="private-product-title">{presentation.productName}</h1>
      <p id="private-checkout-warning" class="private-warning"><strong>Not a retail offer.</strong> Mollie test mode only. Do not enter real personal or payment information.</p>
      <p>Product content, specifications and retail pricing remain unapproved. The commerce API will independently retrieve the private fixture and calculate the authoritative test total.</p>
    </section>
    <form class="private-checkout-form" data-private-checkout data-api-url={presentation.apiUrl} aria-describedby="private-checkout-warning" novalidate>
      <input type="hidden" name="productSlug" value={presentation.productSlug}/>
      <p class="required-note"><span aria-hidden="true">*</span> Required fields</p>

      <fieldset>
        <legend>Test basket</legend>
        <label><span class="field-label">Quantity <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <input name="quantity" type="number" min="1" max="3" step="1" value="1" required/></label>
        <label>Test payment method <select name="paymentMethod"><option value="">Available Mollie test methods</option><option value="klarna">Klarna test (where supported)</option></select></label>
      </fieldset>
      <fieldset>
        <legend>Test contact and delivery details</legend>
        <label><span class="field-label">Email address <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <input name="email" type="email" value="test@example.invalid" autocomplete="off" required/></label>
        <label><span class="field-label">First name <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <input name="givenName" value="Test" autocomplete="off" required/></label>
        <label><span class="field-label">Last name <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <input name="familyName" value="Customer" autocomplete="off" required/></label>
        <label><span class="field-label">Address line 1 <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <input name="line1" value="1 Test Street" autocomplete="off" required/></label>
        <label>Address line 2 (optional) <input name="line2" autocomplete="off"/></label>
        <label>State / province / region (where applicable) <input name="region" autocomplete="off"/></label>
        <label><span class="field-label">Town or city <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <input name="locality" value="London" autocomplete="off" required/></label>
        <label><span class="field-label">Postcode <span class="required-mark" data-required-for="postcode" aria-hidden="true">*</span><span class="sr-only" data-required-text-for="postcode"> (required)</span></span> <input name="postalCode" value="SW1A 1AA" autocomplete="off" required/></label>
        <label><span class="field-label">Country <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <select name="countryCode" required>{countries.map(country => <option value={country.code} selected={country.code === "GB"}>{country.name}</option>)}</select></label>
      </fieldset>
      <fieldset>
        <legend>Delivery method</legend>
        <label><span class="field-label">Delivery option <span class="required-mark" aria-hidden="true">*</span><span class="sr-only"> (required)</span></span> <select name="deliveryMethod"><option value="tracked-postage-packing">Home delivery — £3.99 (UK)</option><option value="inpost-locker-shop">InPost locker/shop collection — £2.59 (UK)</option></select></label>
        <div data-collection-fields hidden>
          <p><a href="https://inpost.co.uk/lockers" target="_blank" rel="noopener noreferrer">Find an InPost locker or shop (opens in a new tab)</a>. Copy the point name and full address into one field, including its UK postcode. The location ID is optional. Your request will be checked before booking; no alternative will be substituted without your agreement.</p>
          <label><span class="field-label">Collection point name and full address <span class="required-mark" data-required-for="collection" hidden aria-hidden="true">*</span><span class="sr-only" data-required-text-for="collection" hidden> (required)</span></span> <input name="collectionNameAddress" maxlength="500" autocomplete="off" aria-describedby="collection-address-error"/></label>
          <p id="collection-address-error" role="alert" hidden></p>
          <label><span class="field-label">InPost location ID (optional)</span> <input name="collectionLocationId" maxlength="40" autocomplete="off" placeholder="e.g. UK00373494"/></label>
          <label><span class="field-label">Recipient UK mobile number <span class="required-mark" data-required-for="collection" hidden aria-hidden="true">*</span><span class="sr-only" data-required-text-for="collection" hidden> (required)</span></span> <input name="phone" type="tel" maxlength="30" autocomplete="off"/></label>
          <p>InPost uses your email and mobile number for collection notifications. Wait for InPost to confirm your parcel is ready to collect.</p>
        </div>
      </fieldset>
      <section aria-labelledby="quote-title" aria-live="polite">
        <h2 id="quote-title">Order total</h2>
        <p>Tracked postage and packing: UK Royal Mail Tracked 48 home delivery £3.99 for 1 device, £7.99 for 2–3 devices / InPost collection £2.59 for 1–2 devices (Medium), £3.99 for 3 devices (Large) · Europe (including Turkey) £14.99 · Rest of world £25.99. Subject to destination approval.</p>
        <dl data-quote-summary></dl>
      </section>
      <div data-import-charges hidden>
        <p id="import-charges-notice">{importChargesNotice}</p>
        <label class="import-acceptance"><input id="import-charges-accepted" type="checkbox" name="importChargesAccepted" aria-describedby="import-charges-notice"/> <span>I understand that international import charges are excluded and payable separately. <span class="required-mark" data-required-for="imports" aria-hidden="true" hidden>*</span><span class="sr-only" data-required-text-for="imports" hidden> (required)</span></span></label>
      </div>
      <button class="button" type="submit" disabled>Continue to Mollie test checkout</button>
      <p class="form-status" data-checkout-status role="status" aria-live="polite" tabindex="-1"></p>
    </form>
  </main>
  <script>
    import { collectionPointFromAddress, normaliseUkMobile } from "../../../packages/commerce-core/src/collection";
    // Compile out private checkout behaviour when its existing presentation gate is disabled.
    if (import.meta.env.PUBLIC_COMMERCE_UI_ENABLED === "true") {
    const form = document.querySelector("[data-private-checkout]");
    const status = document.querySelector("[data-checkout-status]");
    if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']")!;
      const summary = form.querySelector<HTMLElement>("[data-quote-summary]")!;
      const imports = form.querySelector<HTMLElement>("[data-import-charges]")!;
      const acceptance = form.querySelector<HTMLInputElement>("[name='importChargesAccepted']")!;
      const country = form.querySelector<HTMLSelectElement>("[name='countryCode']")!;
      const method = form.querySelector<HTMLSelectElement>("[name='deliveryMethod']")!;
      const collectionFields = form.querySelector<HTMLElement>("[data-collection-fields]")!;
      const collectionInputs = [...collectionFields.querySelectorAll<HTMLInputElement>("input")];
      const quantity = form.querySelector<HTMLInputElement>("[name='quantity']")!;
      const postal = form.querySelector<HTMLInputElement>("[name='postalCode']")!;
      type Quote = { shippingQuoteRevision: string; shippingRateId: string; totalMinor: number; subtotalMinor: number; taxMinor: number; deliveryMinor: number; currency: string };
      let quote: Quote | undefined;
      let revision = 0;
      let submitting = false;
      const collectionAddress=form.querySelector<HTMLInputElement>("[name='collectionNameAddress']")!;
      const collectionError=form.querySelector<HTMLElement>("#collection-address-error")!;
      const validateCollectionAddress=()=>{
        collectionAddress.setCustomValidity("");collectionError.hidden=true;collectionAddress.removeAttribute("aria-invalid");
        if(method.value!=="inpost-locker-shop" || collectionAddress.disabled)return;
        try{collectionPointFromAddress(collectionAddress.value);}catch(error){const message=error instanceof Error?error.message:"Include a valid UK postcode in the full address.";collectionAddress.setCustomValidity(message);collectionError.textContent=message;collectionError.hidden=false;collectionAddress.setAttribute("aria-invalid","true");}
      };
      collectionAddress.addEventListener("input",validateCollectionAddress);
      const refreshQuote = async () => {
        const current = ++revision;
        quote = undefined;
        button.disabled = true;
        summary.replaceChildren();
        acceptance.checked = false;
        imports.hidden = country.value === "GB";
        acceptance.required = !imports.hidden;
        postal.required = country.value !== "AE";
        for (const node of form.querySelectorAll<HTMLElement>("[data-required-for='postcode'],[data-required-text-for='postcode']")) node.hidden = !postal.required;
        for (const node of form.querySelectorAll<HTMLElement>("[data-required-for='imports'],[data-required-text-for='imports']")) node.hidden = imports.hidden;
        const uk = country.value === "GB";
        method.options[0]!.textContent = uk ? Number(quantity.value) > 1 ? "Royal Mail Tracked 48 home delivery — £7.99" : "Royal Mail Tracked 48 home delivery — £3.99" : "International tracked postage and packing";
        method.options[1]!.disabled = !uk;
        if (!uk) method.value = "tracked-postage-packing";
        method.options[1]!.textContent = Number(quantity.value) === 3 ? "InPost locker/shop collection — £3.99 (Large, UK)" : "InPost locker/shop collection — £2.59 (Medium, UK)";
        const collecting = uk && method.value === "inpost-locker-shop";
        collectionFields.hidden = !collecting;
        const payment = form.querySelector<HTMLSelectElement>("[name='paymentMethod']")!;
        payment.options[1]!.disabled = collecting;
        if (collecting && payment.value === "klarna") payment.value = "";
        for (const input of collectionInputs) { input.required = collecting && input.name !== "collectionLocationId"; input.disabled = !collecting; }
        for (const node of form.querySelectorAll<HTMLElement>("[data-required-for='collection'],[data-required-text-for='collection']")) node.hidden = !collecting;
        status.textContent = "Checking destination approval and total…";
        status.dataset.state = "";
        try {
          const response = await fetch(`${form.dataset.apiUrl}/checkout/quote`, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productSlug: new FormData(form).get("productSlug"), quantity: Number(quantity.value), countryCode: country.value, deliveryMethod: method.value }),
          });
          const result: Quote = await response.json();
          if (current !== revision || submitting) return;
          if (!response.ok || typeof result.shippingRateId !== "string" || typeof result.shippingQuoteRevision !== "string" || result.currency !== "GBP" || ![result.subtotalMinor, result.taxMinor, result.deliveryMinor, result.totalMinor].every(Number.isSafeInteger)) throw new Error("No approved quote.");
          quote = result;
          const format = (value: number) => new Intl.NumberFormat("en-GB", { style: "currency", currency: result.currency }).format(value / 100);
          for (const [label, amount] of [["Products", result.subtotalMinor], ["Tax included in order calculation", result.taxMinor], ["Tracked postage and packing", result.deliveryMinor], ["Total payable", result.totalMinor]] as const) {
            const term = document.createElement("dt"); term.textContent = label;
            const value = document.createElement("dd"); value.textContent = format(amount);
            summary.append(term, value);
          }
          status.textContent = "Test total confirmed. Review your details before continuing.";
          button.disabled = false;
        } catch {
          if (current !== revision || submitting) return;
          status.dataset.state = "error";
          status.textContent = "This destination or basket is not approved for checkout. No payment can be taken.";
        }
      };
      method.addEventListener("change", () => { void refreshQuote(); });
      country.addEventListener("change", () => { void refreshQuote(); });
      quantity.addEventListener("input", () => { void refreshQuote(); });
      void refreshQuote();
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submitting || !quote) return;
        validateCollectionAddress();
        if (!form.reportValidity()) {
          const invalid = [...form.elements].find((element) => element instanceof HTMLInputElement || element instanceof HTMLSelectElement ? !element.checkValidity() : false);
          if (invalid instanceof HTMLElement) invalid.focus();
          status.dataset.state = "error";
          status.textContent = "Please complete the highlighted required field before continuing.";
          return;
        }
        const data = new FormData(form);
        const confirmed = quote;
        submitting = true;
        button.disabled = true;
        form.setAttribute("aria-busy", "true");
        // Freeze the reviewed destination/quantity while payment creation is in progress.
        country.disabled = true; quantity.disabled = true; method.disabled = true;
        status.dataset.state = "";
        status.textContent = "Validating the test basket…";
        try {
          const response = await fetch(`${form.dataset.apiUrl}/checkout`, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
            body: JSON.stringify({
              productSlug: data.get("productSlug"), quantity: Number(data.get("quantity")),
              shippingQuoteRevision: confirmed.shippingQuoteRevision, shippingRateId: confirmed.shippingRateId, expectedTotalMinor: confirmed.totalMinor, deliveryMethod: data.get("deliveryMethod"), email: data.get("email"),
              ...(data.get("paymentMethod") === "klarna" ? { paymentMethod: "klarna" } : {}),
              importChargesAccepted: data.get("importChargesAccepted") === "on",
              correlationId: crypto.randomUUID(),
              deliveryAddress: {
                givenName: data.get("givenName"), familyName: data.get("familyName"), line1: data.get("line1"), line2: data.get("line2"), locality: data.get("locality"), region: data.get("region"),
                postalCode: data.get("postalCode"), countryCode: data.get("countryCode"),
                ...(data.get("deliveryMethod") === "inpost-locker-shop" ? {phone:normaliseUkMobile(String(data.get("phone") ?? "")),collectionPoint:collectionPointFromAddress(String(data.get("collectionNameAddress") ?? ""),String(data.get("collectionLocationId") ?? ""))} : {}),
              },
            }),
          });
          const result = await response.json();
          if (!response.ok || typeof result.checkoutUrl !== "string") throw new Error(response.status < 500 && typeof result.message === "string" ? result.message : "Checkout could not be started.");
          status.textContent = "Opening Mollie test checkout…";
          window.location.assign(result.checkoutUrl);
        } catch (error) {
          status.dataset.state = "error";
          status.textContent = (error instanceof Error ? error.message + " " : "Checkout could not be started. ") + "Review a fresh quote before retrying; an uncertain payment requires operator review.";
          quote = undefined;
          submitting = false;
          country.disabled = false; quantity.disabled = false; method.disabled = false;
          form.removeAttribute("aria-busy");
          status.focus();
          // A new quote requires an explicit change; never automatically repeat payment creation.
        }
      });
    }
    }
  </script>
</BaseLayout>

<style>
  .private-header{display:flex;align-items:center;justify-content:space-between;padding-block:var(--cyph-space-6);border-bottom:1px solid var(--cyph-border-structural)}
  .private-header span{color:var(--cyph-color-warning);font-size:.7rem;letter-spacing:var(--cyph-tracking-label);text-transform:uppercase}
  .private-commerce{display:grid;grid-template-columns:minmax(0,.8fr) minmax(20rem,1fr);gap:var(--cyph-layout-cluster);padding-block:var(--cyph-layout-section-compact)}
  .private-commerce>section{min-width:0}h1{max-width:100%;font-size:clamp(2rem,3.35vw,3.25rem);line-height:1.1;overflow-wrap:anywhere;word-break:normal}.private-commerce section>p{max-width:38rem;color:var(--cyph-text-secondary)}
  .private-warning{padding:var(--cyph-space-4);border-left:2px solid var(--cyph-color-warning);background:rgb(242 198 109/.08)}
  fieldset{display:grid;gap:var(--cyph-space-4);margin:0 0 var(--cyph-space-6);border:1px solid var(--cyph-border-structural);padding:var(--cyph-space-6)}
  legend{padding-inline:var(--cyph-space-2);font-family:var(--cyph-font-display);font-size:.85rem;text-transform:uppercase}
  [data-collection-fields]:not([hidden]){display:grid;gap:var(--cyph-space-4)}
  .field-label{display:inline;line-height:1.5}
  .required-note{font-size:.8rem;color:var(--cyph-text-secondary)}
  .required-mark,.required-note>span{color:var(--cyph-color-error,#e66a7b);font-weight:700}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  label{display:grid;gap:var(--cyph-space-2);color:var(--cyph-text-secondary);font-size:.8rem}input,select{width:100%;min-width:0;min-height:2.75rem;border:1px solid var(--cyph-border-structural);border-radius:var(--cyph-radius-control);padding:var(--cyph-space-3);font-size:1rem;color:var(--cyph-text-primary);background:rgb(8 7 17/.55)}
  select option{background:var(--cyph-color-near-black,#080711);color:var(--cyph-text-primary)}
  [data-quote-summary]{display:grid;grid-template-columns:1fr auto;gap:var(--cyph-space-3)}dd{margin:0;text-align:right}
  .import-acceptance{display:flex;align-items:flex-start;gap:var(--cyph-space-3);margin-block:var(--cyph-space-4)}.import-acceptance input{width:1.25rem;min-height:1.25rem;flex:none}
  [hidden]{display:none!important}
  .form-status:focus{outline:none}.form-status[data-state="error"]{color:var(--cyph-color-error)}
  @media(max-width:760px){.private-commerce{grid-template-columns:1fr}.private-header span{max-width:10rem;text-align:right}.private-checkout-form,fieldset{min-width:0}}
  @media(max-width:420px){.private-header{align-items:flex-start;gap:var(--cyph-space-4)}.private-header span{max-width:8rem}.private-commerce{padding-block:var(--cyph-space-8)}fieldset{padding:var(--cyph-space-4)}}
</style>
