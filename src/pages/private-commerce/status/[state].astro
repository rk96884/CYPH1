---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrandMark from "../../../components/BrandMark.astro";
import { privateCommercePresentation } from "../../../config/private-commerce";

export function getStaticPaths() {
  const presentation = privateCommercePresentation();
  if (!presentation) return [];
  return ["pending", "cancelled", "error", "success"].map((state) => ({ params: { state }, props: { productSlug: presentation.productSlug } }));
}

const state = Astro.params.state ?? "error";
const { productSlug } = Astro.props;
const presentation = privateCommercePresentation();
const apiUrl = presentation?.apiUrl ?? "";
const messages = {
  pending: ["Payment confirmation pending", "Your browser return is not proof of payment. This test order remains pending until an authenticated Mollie webhook updates it."],
  success: ["Payment status received", "This page is still non-authoritative. Confirm the internal order status and verified webhook before treating the test as paid."],
  cancelled: ["Test checkout cancelled", "No successful payment has been inferred from the browser return. You may return to the private test product and try again."],
  error: ["Checkout test interrupted", "The checkout could not be completed. Review the commerce API and Mollie test logs before retrying."],
} as const;
const message = messages[state as keyof typeof messages] ?? messages.error;
---
<BaseLayout title={`${message[0]} — CYPH/1 private test`} description={message[1]} robots="noindex, nofollow, noarchive">
  <header class="private-header container"><BrandMark/><span>Private test environment</span></header>
  <main id="main" class="private-status container" data-order-status data-state={state} data-api-url={apiUrl}>
    <p class="eyebrow">Mollie test mode</p>
    <h1>{message[0]}</h1>
    <p>{message[1]}</p>
    <p class="order-reference" data-order-reference></p>
    <a class="text-link" href={`../../${productSlug}/`}>Return to the private test product</a>
  </main>
  <script>
    const root = document.querySelector("[data-order-status]");
    const output = document.querySelector("[data-order-reference]");
    const order = new URLSearchParams(window.location.search).get("order");
    const validOrder = order && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(order);
    if (output instanceof HTMLElement && validOrder) output.textContent = `Internal order: ${order}`;

    if (root instanceof HTMLElement && root.dataset.state === "pending" && validOrder) {
      const apiUrl = root.dataset.apiUrl;
      if (apiUrl) {
        let attempts = 0;
        const maximumAttempts = 30;
        const poll = async () => {
          attempts += 1;
          try {
            const response = await fetch(`${apiUrl}/orders/${encodeURIComponent(order)}/status`, {
              method: "GET",
              cache: "no-store",
              credentials: "omit",
              headers: { Accept: "application/json" },
            });
            if (response.ok) {
              const result = await response.json();
              if (result?.state === "paid" || result?.state === "cancelled") {
                const target = result.state === "paid" ? "success" : "cancelled";
                window.location.replace(`../${target}/?order=${encodeURIComponent(order)}`);
                return;
              }
            }
          } catch {
            // Keep the non-authoritative pending display; the next bounded poll may recover.
          }
          if (attempts < maximumAttempts) window.setTimeout(poll, 2000);
        };
        window.setTimeout(poll, 1000);
      }
    }
  </script>
</BaseLayout>
<style>
  .private-header{display:flex;align-items:center;justify-content:space-between;padding-block:var(--cyph-space-6);border-bottom:1px solid var(--cyph-border-structural)}
  .private-header span{color:var(--cyph-color-warning);font-size:.7rem;letter-spacing:var(--cyph-tracking-label);text-transform:uppercase}
  .private-status{min-height:70svh;padding-block:var(--cyph-layout-section)}h1{max-width:12ch;font-size:clamp(2.4rem,7vw,6rem);line-height:1.08}.private-status>p{max-width:42rem;color:var(--cyph-text-secondary)}.order-reference{overflow-wrap:anywhere;font-family:ui-monospace,monospace;font-size:.75rem}
  @media(max-width:420px){.private-header{align-items:flex-start;gap:var(--cyph-space-4)}.private-header span{max-width:8rem;text-align:right}.private-status{padding-block:var(--cyph-space-8)}}
</style>
