.article-phase-grid{display:grid;gap:var(--cyph-space-4);margin-top:var(--cyph-space-10);padding:0 var(--cyph-layout-gutter);list-style:none}.article-phase-grid li{padding:var(--cyph-space-6);border-top:var(--cyph-line-structural) solid var(--cyph-border-structural);opacity:0;transform:translateY(var(--cyph-space-4));transition:opacity var(--cyph-motion-editorial) var(--cyph-ease-standard),transform var(--cyph-motion-editorial) var(--cyph-ease-standard)}.article-phase-grid li.is-visible{opacity:1;transform:none}.article-phase-grid li.active{border-top-color:var(--cyph-accent-primary)}
.routine-line{display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr auto;align-items:center;gap:var(--cyph-space-3);margin:var(--cyph-space-8) 0;color:var(--cyph-accent-highlight);font-size:.72rem;letter-spacing:.12em}.routine-line i{display:block;height:1px;background:var(--cyph-border-structural);transform:scaleX(0);transform-origin:left}.routine-line.is-visible i{animation:routine-draw 900ms var(--cyph-ease-standard) forwards}.routine-line.is-visible i:nth-of-type(2){animation-delay:180ms}.routine-line.is-visible i:nth-of-type(3){animation-delay:360ms}
.article-sources{padding-left:1.25rem}.article-sources li+li{margin-top:var(--cyph-space-3)}.related-link{margin-top:var(--cyph-space-8)}.article-cta{padding-block:clamp(3rem,6vw,5.5rem);border-top:var(--cyph-line-structural) solid var(--cyph-border-structural)}
[data-reveal]{transform:translateX(-.08em)}[data-reveal].is-visible{animation:heading-reveal 680ms var(--cyph-ease-standard) both}@keyframes heading-reveal{from{opacity:.12;transform:translateY(.34em) translateX(-.08em);filter:blur(3px)}55%{opacity:.78;filter:blur(.5px)}to{opacity:1;transform:translateY(0) translateX(-.08em);filter:blur(0)}}@keyframes routine-draw{to{transform:scaleX(1)}}
:global(.article-phase-grid li.is-visible .phase-anagen .ipl-beam){animation:ipl-beam 3.6s var(--cyph-ease-standard) infinite;transform-origin:89px 89px}:global(.article-phase-grid li.is-visible .phase-anagen .ipl-pulse){fill:none;stroke:var(--cyph-accent-highlight);stroke-width:1.4;transform-origin:89px 89px;animation:ipl-pulse 3.6s var(--cyph-ease-standard) infinite}:global(.article-phase-grid li.is-visible .phase-anagen .ipl-core){fill:var(--cyph-color-soft-white);filter:drop-shadow(0 0 7px var(--cyph-accent-primary));transform-origin:89px 89px;animation:ipl-core 3.6s var(--cyph-ease-standard) infinite}@keyframes ipl-beam{0%,68%,100%{opacity:0}72%{opacity:.18}77%{opacity:1}82%{opacity:.28}}@keyframes ipl-pulse{0%,72%,100%{opacity:0;transform:scale(.72)}77%{opacity:1;transform:scale(.95)}86%{opacity:0;transform:scale(1.6)}}@keyframes ipl-core{0%,73%,100%{opacity:0;transform:scale(.55)}77%{opacity:1;transform:scale(1.35)}83%{opacity:0;transform:scale(.8)}}
@media(min-width:48rem){.article-phase-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:72rem){.article-phase-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:47.99rem){.article-hero{padding-top:10.75rem;padding-bottom:var(--cyph-space-12)}.article-hero h1{font-size:clamp(2.15rem,11vw,3.25rem);line-height:1.1}.article-section{padding-block:var(--cyph-space-12)}}@media(prefers-reduced-motion:reduce){[data-reveal],.article-phase-grid li,.routine-line{opacity:1;transform:none;animation:none!important;filter:none}.routine-line i{transform:scaleX(1)}:global(.article-phase-grid .phase-illustration *){animation:none!important}:global(.article-phase-grid .ipl-effect){display:none}}
</style>
