---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductGallery from "../components/ProductGallery.astro";
import { launchProduct } from "../data/launch-product";
import { growthPhases } from "../data/brand";
import { withBase } from "../utils/base-path";
import "../styles/product.css";
const price = new Intl.NumberFormat("en-GB", { style: "currency", currency: launchProduct.intendedPrice.currency }).format(launchProduct.intendedPrice.amount);
const signup = withBase("#early-access");
// Project-owner-confirmed manual and usage-card evidence, 7 October 2026.
const compatibility = [
  { title: "Skin tones", id: "skin", suitable: ["White", "Beige", "Light brown", "Mid brown"], unsuitable: ["Dark brown", "Brownish black"] },
  { title: "Natural hair colours", id: "hair", suitable: ["Black", "Dark brown", "Brown", "Light brown"], unsuitable: ["Light blonde", "Red", "White"] },
];
const swatchName = (label: string) => label.toLowerCase().replaceAll(" ", "-");
// Deliberately no Offer, availability, SKU, ratings or unapproved product properties.
const structuredData = {
  "@context": "https://schema.org", "@type": "Product", name: launchProduct.name,
  brand: { "@type": "Brand", name: "CYPH/1" },
  description: "An at-home IPL hair removal device from CYPH/1. Pre-launch; not yet available to purchase.",
};
---
<BaseLayout title="IPL Hair Removal Device — Coming soon | CYPH/1" description="Meet the CYPH/1 IPL Hair Removal Device. Intended launch price £74.99. Explore our at-home IPL approach and join the launch list. Not yet available to purchase." structuredData={structuredData}>
  <Header />
  <main id="main" class="product-page">
    <section class="section product-hero" aria-labelledby="product-heading">
      <div class="container product-hero-grid">
        <ProductGallery />
        <div class="product-summary">
          <p class="eyebrow">Target the growth.</p>
          <p class="launch-state">Pre-launch · Coming soon</p>
          <h1 id="product-heading">{launchProduct.name}</h1>
          <p class="product-price">{price} <span>Intended launch price</span></p>
          <p class="lede">At-home IPL. A routine of your own.</p>
          <p>Discover the next chapter of CYPH/1: light-based hair removal for use at home, with clear guidance at every step.</p>
          <a class="button" href={signup}>Join the launch list</a>
          <p class="form-note">Not yet available to purchase. Joining the list is not a reservation or pre-order.</p>
          <a class="text-link" href="#product-introduction">Explore the device ↓</a>
        </div>
      </div>
    </section>
    <section id="product-introduction" class="section product-editorial" aria-labelledby="introduction-heading">
      <div class="container product-split"><p class="section-index">01 / The introduction</p><div><h2 id="introduction-heading">Light technology.<br/>At home.</h2><p>IPL stands for intense pulsed light. It is a light-based approach to hair removal, used over time rather than as a one-off treatment.</p><p>We’re preparing the CYPH/1 IPL Hair Removal Device for launch. Explore the principles behind IPL now; full device guidance will be available before sales open.</p></div></div>
    </section>
    <section class="section" aria-labelledby="features-heading">
      <div class="container"><p class="section-index">02 / The essentials</p><h2 id="features-heading">A considered approach.</h2><div class="product-columns"><article><h3>Flash modes</h3><p>Manual and automatic flash modes.</p></article><article><h3>Energy controls</h3><p>Selectable energy levels. Follow the device instructions when selecting a setting.</p><h3>Turbo Mode</h3><p>Delivers two flashes in quick succession for an enhanced treatment mode.</p></article><article><h3>Automatic shut-off</h3><p>Automatic shut-off after 5 minutes of inactivity.</p></article></div></div>
    </section>
    <section class="section product-editorial" aria-labelledby="areas-heading">
      <div class="container product-split"><p class="section-index">03 / Treatment areas</p><div><h2 id="areas-heading">Know where to begin.</h2><p>CYPH/1 IPL can be used across a range of body areas. Always follow the device instructions for the area you're treating.</p>
        <div class="treatment-groups">
          <article id="areas-women"><h3>For women</h3><p>Upper lip · Chin · Underarms · Arms · Legs · Bikini area</p></article>
          <article id="areas-men"><h3>For men</h3><p>Chest · Back · Arms · Abdomen · Legs</p></article>
        </div>
        <p>For facial use, follow the device instructions carefully and only treat the areas specified in the user guide.</p>
        <p>Check the <a href="#compatibility-guide">compatibility guide below</a> before planning treatment.</p>
        <section id="compatibility-guide" class="compatibility-guide" aria-labelledby="compatibility-heading">
          <h3 id="compatibility-heading">Check your compatibility.</h3>
          <p>Use this guide alongside the complete device instructions. Swatches are illustrative; suitability is described by the colour names.</p>
          <div class="compatibility-columns">{compatibility.map(group => <article aria-labelledby={`${group.id}-heading`}>
            <h4 id={`${group.id}-heading`}>{group.title}</h4>
            {[{label: "Suitable", values: group.suitable, id: "suitable"}, {label: "Not suitable", values: group.unsuitable, id: "unsuitable"}].map(status => <div id={`${group.id}-${status.id}`} class="compatibility-status">
              <p><strong>{status.label}</strong></p>
              <ul class="compatibility-swatches">{status.values.map(label => <li><span aria-hidden="true" class={`compatibility-swatch swatch-${group.id}-${swatchName(label)}`}></span><span>{label}</span></li>)}</ul>
            </div>)}
          </article>)}</div>
        </section>
      </div></div>
    </section>
    <section class="section" aria-labelledby="included-heading">
      <div class="container product-split"><p class="section-index">04 / In the box</p><div><h2 id="included-heading">The launch kit.</h2><p>Your device and the essentials for use at home.</p><ul id="launch-kit-contents" class="product-safety-list"><li>CYPH/1 IPL Hair Removal Device</li><li>Power adaptor</li><li>Protective goggles</li><li>User manual and guidance card</li><li>Razor</li></ul></div></div>
    </section>
    <section class="section product-editorial" aria-labelledby="science-heading">
      <div class="container"><p class="section-index">05 / How IPL works</p><h2 id="science-heading">Informed by the cycle.</h2><p class="product-reading">IPL treatment is repeated over time so treatment can coincide with hairs entering active growth. It does not identify the growth phase of an individual hair.</p><ol class="product-phases">{growthPhases.map(phase => <li><span class="eyebrow">{phase.number}</span><h3>{phase.name}</h3><p>{phase.label}</p></li>)}</ol><a class="text-link" href={withBase("learn/hair-growth-cycle/")}>Explore the hair-growth cycle →</a><br/><a class="text-link" href={withBase("learn/why-ipl-consistency-matters/")}>Why consistency matters →</a></div>
    </section>
    <section class="section" aria-labelledby="safety-heading">
      <div class="container product-split"><p class="section-index">06 / Safety &amp; suitability</p><div><h2 id="safety-heading">Make an informed choice.</h2><p>IPL is not suitable for everyone. Check the <a href="#compatibility-guide">skin-tone and hair-colour compatibility guide</a> and read the complete instructions before use.</p><p><strong>Do not use over tattoos, sunburn, dark spots or moles. Do not use during pregnancy.</strong></p><h3>Before treatment</h3><ul class="product-safety-list"><li>Shave the treatment area; ensure skin is clean and dry.</li><li>Do not wax or pluck the hair.</li><li>Wear the supplied protective eyewear.</li><li>Read the complete instructions before use.</li></ul></div></div>
    </section>
    <section class="section product-editorial" aria-labelledby="information-heading">
      <div class="container"><p class="section-index">07 / The details</p><h2 id="information-heading">Before you order.</h2><div class="product-columns"><article><h3>Delivery</h3><p>Delivery options, charges and estimated timings will be available before sales open.</p></article><article><h3>Returns</h3><p>Our full returns policy will be available to read before you can place an order.</p></article><article><h3>Warranty</h3><p>Warranty terms and how to get support will be shared before launch.</p></article></div></div>
    </section>
    <section class="section" aria-labelledby="launch-heading"><div class="container product-launch"><p class="eyebrow">CYCLE. PHASE. ONE.</p><h2 id="launch-heading">Target the growth.</h2><p>Join the CYPH/1 early-access list for launch information.</p><a class="button" href={signup}>Join the launch list</a><p class="form-note">No payment. No pre-order.</p></div></section>
  </main>
  <Footer />
</BaseLayout>
