---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HairPhaseIllustration from "../components/HairPhaseIllustration.astro";
import { growthPhases } from "../data/brand";
import { withBase } from "../utils/base-path";
const signupApiUrl = import.meta.env.PUBLIC_SIGNUP_API_URL ?? "";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const structuredData = [
  { "@context": "https://schema.org", "@type": "Organization", name: "CYPH/1", alternateName: "Cycle Phase One", url: "https://www.cyph1.co.uk/", email: "info@cyph1.co.uk", logo: "https://www.cyph1.co.uk/brand/generated/cyph1-lockup-clean-flat.svg" },
  { "@context": "https://schema.org", "@type": "WebSite", name: "CYPH/1", alternateName: "Cycle Phase One", url: "https://www.cyph1.co.uk/", inLanguage: "en-GB" },
];
---
<BaseLayout title="CYPH/1 — Target the growth" description="Discover CYPH/1, premium at-home beauty technology informed by the hair-growth cycle. Join the early-access list for product-development updates." structuredData={structuredData}><Header/><main id="main">
<section class="hero section"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Premium at-home beauty technology</p><img class="hero-logo" src={withBase("brand/generated/cyph1-wordmark-clean-metallic.svg")} alt="CYPH/1" width="657" height="165"/><h1>Target the growth.</h1><p class="lede">A new approach to at-home IPL, informed by the rhythm of the hair-growth cycle. Precision, consistency and considered design—coming soon.</p><div class="hero-actions"><a class="button" href="#early-access">Join early access</a><a class="text-link" href="#cycle">Discover the cycle <span aria-hidden="true">↓</span></a></div></div><figure class="product-teaser"><span class="teaser-orbit" aria-hidden="true"></span><img src={withBase("brand/teaser/cyph1-product-direction-v2.webp")} alt="Abstract product-direction silhouette with a visible light-treatment aperture" width="900" height="1350"/><figcaption><span>Product direction</span>Final design subject to change</figcaption></figure></div></section>
<section class="brand-story section" aria-labelledby="brand-heading"><div class="container split-heading"><p class="section-index">01 / The name</p><div class="name-content"><h2 id="brand-heading">Cycle.<br/>Phase.<br/><em>One.</em></h2><div class="name-cycle" aria-hidden="true"><div class="cycle-object"><div class="cycle-orbit orbit-one"></div><div class="cycle-orbit orbit-two"></div><div class="phase-core"><span>01</span><strong>ANAGEN</strong><small>ACTIVE GROWTH</small></div><span class="orbit-label label-cycle">CYCLE</span><span class="orbit-label label-phase">PHASE</span><span class="orbit-label label-one">ONE</span></div></div><p class="name-intro">CYPH/1 begins with a simple principle: hair does not grow all at once. It moves through a repeating cycle, and consistency matters.</p></div></div><div class="container word-breakdown" aria-label="The meaning of CYPH/1"><div><strong>CY</strong><span>Cycle</span></div><div><strong>PH</strong><span>Phase</span></div><div><strong>/1</strong><span>One</span></div></div></section>
<section class="cycle-section section" id="cycle" aria-labelledby="cycle-heading"><div class="container section-intro"><p class="section-index">02 / The science</p><div><h2 id="cycle-heading">Growth moves<br/>in phases.</h2><p>IPL treatment is repeated over time so treatment can coincide with hairs entering active growth. The hair cycle is commonly described in four stages.</p></div></div><ol class="container phase-grid">{growthPhases.map((phase) => <li class:list={{active:phase.active}}><div class="phase-card-meta"><span>{phase.number}</span>{phase.active && <small>Phase one</small>}</div><HairPhaseIllustration phase={phase.name}/><h3>{phase.name}</h3><p class="phase-label">{phase.label}</p><p class="phase-description">{phase.description}</p></li>)}</ol><div class="container science-note"><p><strong>A considered routine, not a shortcut.</strong> IPL treatment does not identify the growth phase of an individual hair. Repeated treatments allow treatment to coincide with different hairs entering active growth.</p></div></section>
<section class="principles section" id="principles" aria-labelledby="principles-heading"><div class="container section-intro"><p class="section-index">03 / Our approach</p><div><h2 id="principles-heading">Built around<br/>what matters.</h2><p>We are developing CYPH/1 around three principles. Product details will be published only when they are verified.</p></div></div><div class="container principle-grid"><article><span>01</span><h3>Precision</h3><p>Technology chosen with purpose, explained with clarity and without inflated claims.</p></article><article><span>02</span><h3>Consistency</h3><p>A considered experience designed around a repeatable at-home routine.</p></article><article><span>03</span><h3>Comfort</h3><p>Thoughtful product selection focused on a controlled, approachable experience.</p></article></div></section>
<section class="early-access section" id="early-access" aria-labelledby="access-heading"><div class="container access-panel"><div><p class="eyebrow">The first 100</p><h2 id="access-heading">Be first in<br/>the cycle.</h2></div><div class="access-copy"><p>Join the CYPH/1 early-access list for product development updates and launch information.</p><form class="signup-form" data-signup-form data-signup-api-url={signupApiUrl} data-turnstile-site-key={turnstileSiteKey} aria-describedby="signup-note signup-status" novalidate><label for="email">Email address</label><div class="input-row"><input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.co.uk" required/><button class="button" type="submit">Join early access</button></div><label class="consent-control"><input name="consent" type="checkbox" required/><span>Yes, I’d like to receive CYPH/1 product-development updates and launch information by email. I can unsubscribe at any time.</span></label><div class="signup-challenge" data-turnstile-container></div><p id="signup-note" class="form-note">We’ll send an email asking you to confirm. Read our <a href={withBase("privacy/")}>Privacy Notice</a>. No payment or pre-order.</p><p id="signup-status" class="form-status" data-signup-status role="status" aria-live="polite"></p></form></div></div></section>
</main><Footer/></BaseLayout>

<script>
  interface TurnstileApi {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    reset(widget?: string | HTMLElement): void;
  }
  declare global { interface Window { turnstile?: TurnstileApi; cyphTurnstileReady?: () => void; } }
  (() => {
    const form = document.querySelector("[data-signup-form]");
    if (!(form instanceof HTMLFormElement)) return;
    const signupApiUrl = form.dataset.signupApiUrl || "";
    const turnstileSiteKey = form.dataset.turnstileSiteKey || "";
    const status = form.querySelector("[data-signup-status]");
    const button = form.querySelector("button[type='submit']");
    const challenge = form.querySelector("[data-turnstile-container]");
    let turnstileToken = "";
    const setStatus = (message: string, state = "") => { if (status instanceof HTMLElement) { status.textContent = message; status.dataset.state = state; } };
    if (signupApiUrl && turnstileSiteKey && challenge instanceof HTMLElement) {
      window.cyphTurnstileReady = () => {
        window.turnstile?.render(challenge, { sitekey: turnstileSiteKey, theme: "dark", callback: (token: string) => { turnstileToken = token; }, "expired-callback": () => { turnstileToken = ""; }, "error-callback": () => { turnstileToken = ""; setStatus("The verification check could not load. Please try again.", "error"); } });
      };
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=cyphTurnstileReady&render=explicit";
      script.async = true; script.defer = true; document.head.append(script);
    }
    form.addEventListener("submit", async (event) => {
      event.preventDefault(); setStatus("");
      if (!form.reportValidity()) return;
      if (!signupApiUrl || !turnstileSiteKey) { setStatus("Early-access registration is temporarily unavailable. Please try again later.", "error"); return; }
      if (!turnstileToken) { setStatus("Please complete the verification check.", "error"); return; }
      const email = new FormData(form).get("email");
      if (button instanceof HTMLButtonElement) button.disabled = true;
      form.setAttribute("aria-busy", "true"); setStatus("Submitting…", "pending");
      try {
        const response = await fetch(signupApiUrl, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email, consent: true, turnstileToken }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || "We couldn’t submit your request. Please try again.");
        form.reset(); turnstileToken = ""; if (challenge instanceof HTMLElement) window.turnstile?.reset(challenge);
        setStatus("Check your inbox and confirm your email to join early access.", "success");
      } catch (error) { setStatus(error instanceof Error ? error.message : "We couldn’t submit your request. Please try again.", "error"); }
      finally { form.removeAttribute("aria-busy"); if (button instanceof HTMLButtonElement) button.disabled = false; }
    });
  })();
</script>
