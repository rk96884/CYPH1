---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandMark from "../../components/BrandMark.astro";
import { privateOperationsPresentation } from "../../config/private-operations";
const presentation=privateOperationsPresentation();
export function getStaticPaths(){const value=privateOperationsPresentation();return value?[{params:{slug:value.slug},props:{presentation:value}}]:[];}
const { presentation: configured = presentation }=Astro.props;
if (!configured) throw new Error("Private operations presentation is not configured.");
---
<BaseLayout title="CYPH/1 private operations" description="Restricted commerce operations console." robots="noindex, nofollow, noarchive">
  <main id="main" class="ops" data-api={configured.apiUrl}>
    <div class="ops-bar"><BrandMark/><span>Restricted operations</span></div>
    <header><p class="eyebrow">PRIVATE COMMERCE / OPERATIONS</p><h1>ORDER<br/>CONTROL</h1><p>This presentation route is not authentication. Access must be enforced at the API and hosting edge.</p></header>
    <section aria-labelledby="search-title"><h2 id="search-title">Find an order</h2><form id="search"><label for="query">Order number</label><div class="input-action"><input id="query" name="q" autocomplete="off" enterkeyhint="search" required/><button>Search</button></div></form><p id="message" role="status" aria-live="polite"></p><div id="results" aria-label="Order search results"></div></section>
    <section id="details" hidden aria-labelledby="details-title"><h2 id="details-title" tabindex="-1">Order timeline</h2><div id="summary"></div><ol id="timeline"></ol>
      <form id="capture"><h3>Capture payment</h3><p>Capture the authorised payment for this order. An existing capture attempt must be reconciled before any further action.</p><button type="submit">Capture authorised payment</button></form>
      <form id="reconcile-capture" hidden><h3>Reconcile capture</h3><p>An earlier capture command exists. Check its provider outcome and, only when safe, resume the original command.</p><button type="submit">Reconcile capture</button></form>
      <form id="refund" novalidate><h3>Issue refund</h3><p id="refund-warning" role="status" aria-live="polite" hidden><strong>Refund requires resolution</strong><br/>The provider outcome is uncertain. Do not issue another refund until this has been resolved.</p><p id="refund-message" role="status" aria-live="polite" aria-atomic="true"></p><label for="amount">Refund amount (GBP)</label><input id="amount" name="amount" type="text" inputmode="decimal" placeholder="0.50" aria-describedby="refund-amount-error refund-message" required/><p id="refund-amount-error" role="alert"></p><label for="reason">Approved reason</label><select id="reason" name="reason"><option value="customer_request">Customer request</option><option value="cancelled_order">Cancelled order</option><option value="returned_goods">Returned goods</option><option value="operator_correction">Operator correction</option></select><button type="submit" aria-describedby="refund-warning refund-message" disabled>Submit refund</button></form>
      <section id="returns" aria-labelledby="returns-title">
        <h3 id="returns-title">Merchandise returns</h3>
        <p>Approval records a return decision. It does not issue a refund, mark goods received or change fulfilment or stock.</p>
        <p id="returns-message" role="status" aria-live="polite" aria-atomic="true"></p>
        <button id="returns-refresh" type="button">Reload returns</button>
        <label for="return-choice">Return</label><select id="return-choice" disabled></select>
        <p id="return-summary"></p><ul id="return-items"></ul>
        <form id="return-approve" hidden>
          <h4>Approve requested return</h4>
          <fieldset id="return-quantities"><legend>Approved quantities</legend></fieldset>
          <label for="return-amount">Approved refund amount (minor units)</label>
          <input id="return-amount" type="number" inputmode="numeric" min="0" step="1" required aria-describedby="return-money-help return-error"/>
          <p id="return-money-help">Enter an explicit amount, including zero. This records the decision only; no refund is submitted.</p>
          <label for="return-receipt">Physical receipt</label>
          <select id="return-receipt"><option value="required">Required</option><option value="receipt_not_required">Not required</option><option value="operator_waiver">Explicit operator waiver</option></select>
          <button type="submit">Approve return decision</button>
        </form>
        <form id="return-refund" hidden>
          <p>Issue the approved amount shown above. Requires returns:approve and refunds:create. Submission does not receive goods or close the return.</p>
          <button type="submit">Issue approved refund</button>
        </form>
        <p id="return-linked-refunds" aria-live="polite"></p>
        <form id="return-reject" hidden>
          <h4>Reject requested return</h4>
          <label for="return-reason">Rejection reason</label>
          <select id="return-reason"><option value="not_approved">Not approved</option><option value="duplicate_request">Duplicate request</option></select>
          <button type="submit">Reject return</button>
        </form>
        <p id="return-error" role="alert"></p>
      </section>
    </section>
    <section aria-labelledby="export-title"><h2 id="export-title">Reconciliation</h2><form id="export"><label>From <input type="date" name="from" required/></label><label>To <input type="date" name="to" required/></label><button>Download CSV</button></form></section>
  </main>
  <style>
    .ops input[type="date"] { background-position: right 1.3rem center; }
    .ops input[type="date"]::-webkit-calendar-picker-indicator { transform: translateX(30px); }
    .ops #returns > label { display: block; margin-top: var(--cyph-space-4); }
    .ops #return-choice { width: 100%; margin-top: var(--cyph-space-2); }
    .ops #return-quantities { min-width: 0; display: grid; gap: var(--cyph-space-3); padding: 0; border: 0; }
  </style>
  <script is:inline type="module">
    const root=document.querySelector('.ops');const api=root?.getAttribute('data-api')??'';const message=document.querySelector('#message');let orderId='';let orderLoadSequence=0;
    const say=(text,state='')=>{if(message instanceof HTMLElement){message.textContent=text;message.dataset.state=state;}};
    const rowLabel=(order)=>`${order.orderNumber} — ${order.status}`;
    document.querySelector('#search')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget;if(!form.reportValidity())return;form.setAttribute('aria-busy','true');say('Searching…');try{const q=new FormData(form).get('q');const response=await fetch(`${api}/operations/orders?q=${encodeURIComponent(String(q??''))}`,{credentials:'include'});if(!response.ok)throw new Error();const data=await response.json();const results=document.querySelector('#results');if(results){results.textContent='';resultRows.clear();for(const order of data.orders){const button=document.createElement('button');resultRows.set(order.id,button);button.type='button';button.textContent=rowLabel(order);button.addEventListener('click',()=>load(order.id));results.append(button);}}say(`${data.orders.length} order(s) found.`,'success');}catch{say('Search failed. Check access.','error');}finally{form.removeAttribute('aria-busy');}});
    const captureForm=document.querySelector('#capture');
    const reconcileForm=document.querySelector('#reconcile-capture');
    const captureKeys=new Map();
    const resultRows=new Map();
    function lockCapture(){for(const form of [captureForm,reconcileForm]){const button=form.querySelector('button');if(button)button.disabled=true;}}
    const refundForm=document.querySelector('#refund');
    const refundButton=refundForm.querySelector('button');
    const refundAmount=document.querySelector('#amount');
    const refundMessage=document.querySelector('#refund-message');
    const refundWarning=document.querySelector('#refund-warning');
    const amountError=document.querySelector('#refund-amount-error');
    const refundSay=(text)=>{refundMessage.textContent=text;};
    const unresolvedMessage='Refund unavailable — a previous refund requires resolution before another refund can be issued.';
    const uncertainMessage='The refund could not be confirmed. Check the order status before trying again.';
    let refundUnresolved=false;let refundReady=false;let refundBusy=false;
    function lockRefund(){refundReady=false;refundButton.disabled=true;}
    function refundState(data){
      refundSay('');
      refundUnresolved=Array.isArray(data.refunds)&&data.refunds.some(refund=>refund.status==='resolution_required');
      refundWarning.hidden=!refundUnresolved;
      refundReady=Array.isArray(data.refunds)&&data.order.currency==='GBP';
      refundButton.disabled=!refundReady||refundUnresolved||refundBusy;
      if(refundUnresolved)refundSay(unresolvedMessage);
      else if(data.order.currency!=='GBP')refundSay('Refund controls are available for GBP orders only.');
    }
    refundAmount.addEventListener('input',()=>{amountError.textContent='';refundAmount.removeAttribute('aria-invalid');});
    async function load(id,reportFailure=true){const sequence=++orderLoadSequence;lockCapture();lockRefund();document.querySelector('#returns')?.dispatchEvent(new CustomEvent('operations-order-loading'));try{const response=await fetch(`${api}/operations/orders/${id}`,{credentials:'include'});if(!response.ok)throw new Error();const data=await response.json();if(sequence!==orderLoadSequence)return false;if(orderId!==id){refundSay('');amountError.textContent='';refundAmount.removeAttribute('aria-invalid');}orderId=id;refundState(data);
      const row=resultRows.get(id);if(row)row.textContent=rowLabel(data.order);
      const pending=data.captureCommand?.status==='pending';
      const explanation=reconcileForm.querySelector('p');if(explanation)explanation.textContent=pending?'Capture submitted — awaiting provider confirmation.':'Check the existing capture.';
      const existing=!!data.captureCommand;
      captureForm.hidden=existing;
      reconcileForm.hidden=!existing||data.captureCommand.status==='completed';
      const captureButton=captureForm.querySelector('button');if(captureButton)captureButton.disabled=existing||data.order.status!=='pending_payment'||!data.payments.some((payment)=>payment.status==='authorised');
      const reconcileButton=reconcileForm.querySelector('button');if(reconcileButton)reconcileButton.disabled=reconcileForm.hidden;
      const details=document.querySelector('#details');details?.removeAttribute('hidden');const summary=document.querySelector('#summary');if(summary)summary.textContent=`${data.order.orderNumber} · ${data.order.status} · ${data.order.currency} ${Number(data.order.totalMinor/100).toFixed(2)}`;const timeline=document.querySelector('#timeline');if(timeline){timeline.textContent='';for(const item of data.timeline){const li=document.createElement('li');li.textContent=`${new Date(item.occurredAt).toLocaleString()} — ${item.action}`;timeline.append(li);}(details?.querySelector('#details-title'))?.focus();}document.querySelector('#returns')?.dispatchEvent(new CustomEvent('operations-order-loaded',{detail:{id,data}}));return true;}catch{if(reportFailure)say('Order load failed.','error');return false;}}
    async function submitCapture(event,reconcile){
      event.preventDefault();if(!orderId)return;
      const id=orderId;const form=event.currentTarget;lockCapture();form.setAttribute('aria-busy','true');say(reconcile?'Reconciling capture…':'Submitting capture…');
      try{
        let key=captureKeys.get(id);if(!reconcile&&!key){key=crypto.randomUUID();captureKeys.set(id,key);}
        const response=await fetch(`${api}/operations/orders/${id}/capture${reconcile?'/reconcile':''}`,{method:'POST',credentials:'include',headers:reconcile?{}:{'Idempotency-Key':key}});
        const data=await response.json();
        if(!response.ok)throw new Error(data.message??'Capture request failed.');
        say(data.message??(data.status==='completed'?'Capture completed.':'Capture requires manual resolution.'),data.status==='completed'?'success':data.status==='pending'?'':'error');
      }catch(error){say(`${error instanceof Error?error.message:'Capture outcome uncertain.'} Use Reconcile capture.`,'error');}
      finally{form.removeAttribute('aria-busy');await load(id);}
    }
    captureForm.addEventListener('submit',(event)=>submitCapture(event,false));
    reconcileForm.addEventListener('submit',(event)=>submitCapture(event,true));
    refundForm.addEventListener('submit',async(event)=>{
      event.preventDefault();if(!orderId||refundBusy)return;
      if(refundUnresolved){refundSay(unresolvedMessage);return;}
      if(!refundReady){refundSay('Reload the order before submitting a refund.');return;}
      const value=refundAmount.value.trim();
      const match=/^(\d+)(?:\.(\d{1,2}))?$/.exec(value);
      const amountMinor=match?Number(match[1]+(match[2]??'').padEnd(2,'0')):0;
      if(!Number.isSafeInteger(amountMinor)||amountMinor<=0){amountError.textContent='Enter a valid refund amount.';refundAmount.setAttribute('aria-invalid','true');refundAmount.focus();return;}
      const id=orderId;const values=new FormData(refundForm);refundBusy=true;refundButton.disabled=true;refundForm.setAttribute('aria-busy','true');refundSay('Submitting refund…');
      let outcome=uncertainMessage;
      try{
        const response=await fetch(`${api}/operations/orders/${id}/refunds`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','Idempotency-Key':crypto.randomUUID()},body:JSON.stringify({amountMinor,reason:String(values.get('reason')??'')})});
        const data=await response.json().catch(()=>({}));
        if(response.ok)outcome=data.status==='pending'?'Refund submitted — awaiting provider confirmation.':data.status==='failed'?uncertainMessage:'Refund submitted.';
        else if(response.status===401||response.status===403)outcome='You do not have permission to issue this refund.';
        else if(response.status===409&&data.code==='conflict'&&['Refund amount exceeds the unreserved payment balance.','The provider no longer reports enough refundable value.'].includes(data.message??''))outcome='Refund amount exceeds the remaining refundable balance.';
        else if(response.status===400&&data.code==='invalid_request'&&data.message==='Refund amount must be a positive integer in minor units.')outcome='Enter a valid refund amount.';
        else if(response.status<500)outcome='Refund unavailable. Check the order status and refund details.';
      }catch{outcome=uncertainMessage;}
      finally{
        refundBusy=false;refundForm.removeAttribute('aria-busy');
        const loaded=await load(id,false);
        refundSay(refundUnresolved&&loaded?unresolvedMessage:outcome+(loaded?'':' Reload the order before submitting another refund.'));
      }
    });
    document.querySelector('#returns')?.addEventListener('operations-return-changed',()=>{if(orderId)load(orderId,false);});
    document.querySelector('#export')?.addEventListener('submit',(event)=>{event.preventDefault();const values=new FormData(event.currentTarget);const from=new Date(`${values.get('from')}T00:00:00Z`).toISOString(),to=new Date(`${values.get('to')}T00:00:00Z`).toISOString();location.href=`${api}/operations/reconciliation.csv?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;});
  </script>
  <script is:inline type="module" data-return-decisions>
    const panel=document.querySelector('#returns');
    const api=document.querySelector('.ops').getAttribute('data-api');
    const choice=document.querySelector('#return-choice');
    const summary=document.querySelector('#return-summary');
    const itemList=document.querySelector('#return-items');
    const quantities=document.querySelector('#return-quantities');
    const approveForm=document.querySelector('#return-approve');
    const rejectForm=document.querySelector('#return-reject');
    const returnRefundForm=document.querySelector('#return-refund');
    const linkedRefunds=document.querySelector('#return-linked-refunds');
    const amount=document.querySelector('#return-amount');
    const receipt=document.querySelector('#return-receipt');
    const reason=document.querySelector('#return-reason');
    const error=document.querySelector('#return-error');
    const status=document.querySelector('#returns-message');
    const refreshButton=document.querySelector('#returns-refresh');
    let order='',records=[],orderItems=[],selected='',epoch=0,busy=false,ready=false,loading=false;
    const commands=new Map();
    const selectedRecord=()=>records.find(record=>record.id===selected);
    const commandId=record=>`${order}:${record.id}:${record.version}`;
    const announce=text=>{status.textContent=text;};
    function lock(){ready=false;choice.disabled=true;approveForm.querySelector('button').disabled=true;rejectForm.querySelector('button').disabled=true;returnRefundForm.querySelector('button').disabled=true;}
    function render(){
      const record=selectedRecord();itemList.textContent='';quantities.textContent='';
      const legend=document.createElement('legend');legend.textContent='Approved quantities';quantities.append(legend);
      approveForm.hidden=rejectForm.hidden=!record||record.status!=='requested';
      linkedRefunds.textContent=(record?.refunds??[]).map(refund=>`Linked refund ${refund.id} · ${refund.status} · ${refund.currency} ${refund.amountMinor} minor units`).join(' | ');
      returnRefundForm.hidden=!record||record.status!=='approved'||!Number.isSafeInteger(record.approvedRefundMinor)||record.approvedRefundMinor<=0||(record.refunds??[]).length>0;
      returnRefundForm.querySelector('button').disabled=!ready||busy||loading||returnRefundForm.hidden;
      if(!record){summary.textContent='';return;}
      summary.textContent=`${record.reference} · ${record.category} · ${record.status} · version ${record.version} · ${record.currency} · approved refund: ${record.approvedRefundMinor===null?'not decided':`${record.approvedRefundMinor} minor units`}`;
      const pending=commands.get(commandId(record));
      amount.value=pending?.body.approvedRefundMinor===undefined?'':String(pending.body.approvedRefundMinor);
      receipt.value=pending?.body.receiptRequired===false?pending.body.receiptWaiverReason:'required';
      reason.value=pending?.body.reason??'not_approved';
      document.querySelector('label[for="return-amount"]').textContent=`Approved refund amount (minor units, ${record.currency})`;
      for(const item of record.items){
        const name=orderItems.find(row=>row.id===item.orderItemId)?.name_snapshot??item.orderItemId;
        const li=document.createElement('li');li.textContent=`${name} · requested ${item.requestedQuantity} · approved ${item.approvedQuantity??'not decided'} · received ${item.receivedQuantity}`;itemList.append(li);
        if(record.status==='requested'){
          const label=document.createElement('label');const input=document.createElement('input');
          input.id=`return-quantity-${item.orderItemId}`;label.htmlFor=input.id;label.textContent=`Approved quantity — ${name}`;
          input.type='number';input.min='0';input.max=String(item.requestedQuantity);input.step='1';input.required=true;input.inputMode='numeric';input.setAttribute('aria-describedby','return-error');
          input.dataset.item=item.orderItemId;input.value=String(pending?.body.items?.find(row=>row.orderItemId===item.orderItemId)?.quantity??item.requestedQuantity);input.disabled=!!pending||busy;quantities.append(label,input);
        }
      }
      amount.disabled=receipt.disabled=reason.disabled=!!pending||busy;
      approveForm.querySelector('button').disabled=!ready||busy||(!!pending&&pending.action!=='approve');
      rejectForm.querySelector('button').disabled=!ready||busy||(!!pending&&pending.action!=='reject');
    }
    async function refresh(){
      if(!order||loading)return;const id=order;const token=++epoch;lock();
      try{
        const response=await fetch(`${api}/operations/orders/${id}/returns`,{credentials:'include'});
        if(!response.ok)throw new Error(response.status===403?'You do not have permission to read returns.':'Returns could not be loaded.');
        const data=await response.json();if(!Array.isArray(data.returns))throw new Error('Returns could not be loaded.');
        if(token!==epoch||id!==order)return;
        records=data.returns;selected=records.some(record=>record.id===selected)?selected:records[0]?.id??'';
        choice.textContent='';for(const record of records){const option=document.createElement('option');option.value=record.id;option.textContent=`${record.reference} — ${record.status}`;choice.append(option);}
        choice.value=selected;choice.disabled=!records.length||busy;ready=true;render();
        if(!records.length)announce('No merchandise returns for this order.');
      }catch(problem){if(token===epoch){lock();approveForm.hidden=rejectForm.hidden=returnRefundForm.hidden=true;announce(problem instanceof Error?problem.message:'Returns could not be loaded.');}}
    }
    panel.addEventListener('operations-order-loading',()=>{loading=true;++epoch;lock();refreshButton.disabled=true;approveForm.hidden=rejectForm.hidden=returnRefundForm.hidden=true;});
    panel.addEventListener('operations-order-loaded',event=>{loading=false;refreshButton.disabled=busy;if(order!==event.detail.id){selected='';announce('');error.textContent='';}order=event.detail.id;orderItems=event.detail.data.items??[];refresh();});
    refreshButton.addEventListener('click',()=>{if(!busy)refresh();});
    choice.addEventListener('change',()=>{if(!busy&&ready){selected=choice.value;error.textContent='';render();}});
    async function decide(event,action){
      event.preventDefault();const record=selectedRecord();if(busy||!ready||loading||!record)return;
      if(action==='refund'?(record.status!=='approved'||!Number.isSafeInteger(record.approvedRefundMinor)||record.approvedRefundMinor<=0||(record.refunds??[]).length>0):record.status!=='requested')return;
      error.textContent='';const id=order;const key=commandId(record);let command=commands.get(key);
      if(command&&command.action!==action){error.textContent='The previous decision is unconfirmed. Reload or replay that same decision.';return;}
      if(!command){
        let body={expectedVersion:record.version};
        if(action==='approve'){
          if(!approveForm.reportValidity())return;
          const inputs=Array.from(quantities.querySelectorAll('input'));const items=inputs.map(input=>({orderItemId:input.dataset.item,quantity:Number(input.value)}));
          const value=amount.value.trim();const approvedRefundMinor=/^\d+$/.test(value)?Number(value):NaN;
          if(!Number.isSafeInteger(approvedRefundMinor)||approvedRefundMinor<0||items.some((item,index)=>!Number.isSafeInteger(item.quantity)||item.quantity<0||item.quantity>record.items[index].requestedQuantity)||!items.some(item=>item.quantity>0)){
            error.textContent='Enter an explicit non-negative integer amount and approved quantities within the request, with at least one approved unit.';amount.focus();return;
          }
          const receiptRequired=receipt.value==='required';
          if(!['required','receipt_not_required','operator_waiver'].includes(receipt.value)){error.textContent='Choose a controlled receipt requirement.';return;}
          body={...body,approvedRefundMinor,receiptRequired,...(!receiptRequired?{receiptWaiverReason:receipt.value}:{}),items};
        }else if(action==='reject'){
          if(!['not_approved','duplicate_request'].includes(reason.value)){error.textContent='Choose a controlled rejection reason.';return;}
          body={...body,reason:reason.value};
        }
        command={action,body,key:crypto.randomUUID()};commands.set(key,command);
      }
      busy=true;choice.disabled=refreshButton.disabled=true;panel.setAttribute('aria-busy','true');render();announce('Submitting return decision…');
      try{
        const response=await fetch(`${api}/operations/orders/${id}/returns/${record.id}/${action}`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','Idempotency-Key':command.key},body:JSON.stringify(command.body)});
        if(response.ok){commands.delete(key);if(order===id&&!loading)announce(action==='refund'?'Approved refund submitted. Review its linked state below.':action==='approve'?'Return approved. No refund was issued.':'Return rejected.');}
        else if([400,401,403,409].includes(response.status)){commands.delete(key);if(order===id&&!loading){announce('Return decision not applied.');error.textContent=response.status===403||response.status===401?'You do not have permission to make this return decision.':response.status===409?'The return changed or the command conflicts. Reload and review before acting.':'The return decision was invalid. Review the controlled values.';}}
        else if(order===id&&!loading)announce('Decision outcome unconfirmed. Reload; if still requested, replay the same decision.');
      }catch{if(order===id&&!loading)announce('Decision outcome unconfirmed. Reload; if still requested, replay the same decision.');}
      finally{busy=false;refreshButton.disabled=loading;panel.removeAttribute('aria-busy');if(!loading){await refresh();if(order===id)panel.dispatchEvent(new CustomEvent('operations-return-changed'));}}
    }
    approveForm.addEventListener('submit',event=>decide(event,'approve'));
    rejectForm.addEventListener('submit',event=>decide(event,'reject'));
    returnRefundForm.addEventListener('submit',event=>decide(event,'refund'));
  </script>
</BaseLayout>
