---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { privateOperationsPresentation } from "../../config/private-operations";
const presentation=privateOperationsPresentation();
export function getStaticPaths(){const value=privateOperationsPresentation();return value?[{params:{slug:value.slug},props:{presentation:value}}]:[];}
const { presentation: configured = presentation }=Astro.props;
if (!configured) throw new Error("Private operations presentation is not configured.");
---
<BaseLayout title="CYPH/1 private operations" description="Restricted commerce operations console." robots="noindex, nofollow, noarchive">
  <main id="main" class="ops" data-api={configured.apiUrl}>
    <header><p class="eyebrow">PRIVATE COMMERCE / OPERATIONS</p><h1>ORDER<br/>CONTROL.</h1><p>This presentation route is not authentication. Access must be enforced at the API and hosting edge.</p></header>
    <section aria-labelledby="search-title"><h2 id="search-title">Find an order</h2><form id="search"><label for="query">Order number</label><div><input id="query" name="q" autocomplete="off"/><button>Search</button></div></form><p id="message" role="status"></p><div id="results"></div></section>
    <section id="details" hidden aria-labelledby="details-title"><h2 id="details-title">Order timeline</h2><div id="summary"></div><ol id="timeline"></ol>
      <form id="refund"><h3>Issue refund</h3><label for="amount">Amount (minor units)</label><input id="amount" name="amountMinor" inputmode="numeric" required/><label for="reason">Approved reason</label><select id="reason" name="reason"><option value="customer_request">Customer request</option><option value="cancelled_order">Cancelled order</option><option value="returned_goods">Returned goods</option><option value="operator_correction">Operator correction</option></select><button>Submit refund</button></form>
    </section>
    <section aria-labelledby="export-title"><h2 id="export-title">Reconciliation</h2><form id="export"><label>From <input type="date" name="from" required/></label><label>To <input type="date" name="to" required/></label><button>Download CSV</button></form></section>
  </main>
  <script>
    const root=document.querySelector('.ops');const api=root?.getAttribute('data-api')??'';const message=document.querySelector('#message');let orderId='';
    const say=(text:string)=>{if(message)message.textContent=text;};
    document.querySelector('#search')?.addEventListener('submit',async(event)=>{event.preventDefault();say('Searching…');const q=new FormData(event.currentTarget as HTMLFormElement).get('q');const response=await fetch(`${api}/operations/orders?q=${encodeURIComponent(String(q??''))}`,{credentials:'include'});if(!response.ok){say('Search was not authorised or could not be completed.');return;}const data=await response.json();const results=document.querySelector('#results');if(results){results.textContent='';for(const order of data.orders){const button=document.createElement('button');button.type='button';button.textContent=`${order.orderNumber} — ${order.status}`;button.addEventListener('click',()=>load(order.id));results.append(button);}}say(`${data.orders.length} order(s) found.`);});
    async function load(id:string){const response=await fetch(`${api}/operations/orders/${id}`,{credentials:'include'});if(!response.ok){say('Order could not be loaded.');return;}const data=await response.json();orderId=id;const details=document.querySelector('#details');details?.removeAttribute('hidden');const summary=document.querySelector('#summary');if(summary)summary.textContent=`${data.order.orderNumber} · ${data.order.status} · ${data.order.currency} ${Number(data.order.totalMinor/100).toFixed(2)}`;const timeline=document.querySelector('#timeline');if(timeline){timeline.textContent='';for(const item of data.timeline){const li=document.createElement('li');li.textContent=`${new Date(item.occurredAt).toLocaleString()} — ${item.action}`;timeline.append(li);}}}
    document.querySelector('#refund')?.addEventListener('submit',async(event)=>{event.preventDefault();if(!orderId)return;const values=new FormData(event.currentTarget as HTMLFormElement);const body={amountMinor:Number(values.get('amountMinor')),reason:String(values.get('reason')??'')};const response=await fetch(`${api}/operations/orders/${orderId}/refunds`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','Idempotency-Key':crypto.randomUUID()},body:JSON.stringify(body)});say(response.ok?'Refund submitted.':'Refund was rejected; check permissions and order state.');if(response.ok)await load(orderId);});
    document.querySelector('#export')?.addEventListener('submit',(event)=>{event.preventDefault();const values=new FormData(event.currentTarget as HTMLFormElement);const from=new Date(`${values.get('from')}T00:00:00Z`).toISOString(),to=new Date(`${values.get('to')}T00:00:00Z`).toISOString();location.href=`${api}/operations/reconciliation.csv?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;});
  </script>
</BaseLayout>
<style>.ops{min-height:100vh;background:#080711;color:#f7f3fb;padding:clamp(2rem,6vw,6rem);font-family:Manrope,sans-serif}.ops header,.ops section{max-width:70rem;margin:0 auto 4rem}.eyebrow,label{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:#a371f7}.ops h1{font:400 clamp(3rem,10vw,8rem)/.95 Michroma,sans-serif;margin:1rem 0}.ops h2,.ops h3{font-family:Michroma,sans-serif;font-weight:400}.ops form{display:grid;gap:.75rem;max-width:42rem}.ops input,.ops select,.ops button{font:inherit;padding:.9rem;border:1px solid #76598c;background:#21142d;color:#f7f3fb}.ops button{cursor:pointer;background:#a371f7;color:#080711}.ops #results{display:grid;gap:.5rem;margin-top:1rem}.ops #timeline{border-left:1px solid #76598c;padding-left:2rem;display:grid;gap:1rem}</style>
