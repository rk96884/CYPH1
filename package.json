{
  "name": "cyph1-prelaunch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && npm run check:commerce",
    "check:commerce": "tsc -p packages/commerce-core/tsconfig.json --noEmit && tsc -p apps/commerce-api/tsconfig.json --noEmit",
    "test:commerce": "npm test --workspace @cyph1/commerce-core && npm test --workspace @cyph1/commerce-api",
    "test:staging-monitor": "node --test scripts/check-commerce-staging.test.mjs",
    "test:staging-load": "node --test scripts/check-commerce-staging-load.test.mjs",
    "probe:staging-load": "node scripts/check-commerce-staging-load.mjs",
    "test:customer-route-gates": "node --test scripts/verify-customer-route-gates.test.mjs",
    "test:database-restore": "npm run test:restore-verifier --workspace @cyph1/commerce-api",
    "test:dependency-audit": "node --test scripts/audit-dependencies.test.mjs",
    "verify:customer-route-gates": "node scripts/verify-customer-route-gates.mjs",
    "db:migrate": "npm run db:migrate --workspace @cyph1/commerce-api",
    "db:seed:development": "npm run db:seed:development --workspace @cyph1/commerce-api",
    "db:seed:private-checkout-staging": "npm run db:seed:private-checkout-staging --workspace @cyph1/commerce-api",
    "db:verify": "npm run db:verify --workspace @cyph1/commerce-api",
    "db:verify:restore": "npm run db:verify:restore --workspace @cyph1/commerce-api",
    "validate:deployment-env": "node scripts/validate-deployment-env.mjs",
    "audit:commerce-security": "node scripts/audit-commerce-security.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:a11y": "npm run build && node scripts/audit-accessibility.mjs",
    "audit:private-commerce-a11y": "node scripts/audit-private-commerce-accessibility.mjs",
    "audit:links": "npm run build && node scripts/audit-links.mjs",
    "audit:performance": "npm run build && node scripts/audit-performance.mjs",
    "preview": "astro preview",
    "db:rehearse:worker-recovery": "npm run db:rehearse:worker-recovery --workspace @cyph1/commerce-api",
    "db:rehearse:worker-process-interruption": "npm run db:rehearse:worker-process-interruption --workspace @cyph1/commerce-api",
    "monitor:terminal-worker-failures": "npm run monitor:terminal-worker-failures --workspace @cyph1/commerce-api",
    "test:terminal-worker-failures": "npm run test:terminal-worker-failures --workspace @cyph1/commerce-api",
    "db:rehearse:terminal-worker-failures": "npm run db:rehearse:terminal-worker-failures --workspace @cyph1/commerce-api",
    "test:checkout-capacity-probe": "node --test scripts/check-checkout-admission-capacity.test.mjs",
    "probe:checkout-capacity": "node scripts/check-checkout-admission-capacity.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.3.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2"
  }
}
