# These values are embedded in browser-delivered code and are not secrets.
PUBLIC_SIGNUP_API_URL=https://your-worker.workers.dev/
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Commerce remains disabled throughout pre-launch. This public flag controls
# presentation only; the future commerce API must enforce its own server-side
# COMMERCE_ENABLED gate independently.
PUBLIC_COMMERCE_UI_ENABLED=false
PUBLIC_COMMERCE_TEST_PRODUCT_SLUG=integration-test-fixture
PUBLIC_COMMERCE_TEST_PRODUCT_NAME=INTEGRATION TEST FIXTURE — NOT FOR SALE
PUBLIC_COMMERCE_API_URL=https://private-commerce-api.example/
PUBLIC_COMMERCE_TEST_SHIPPING_RATE_ID=00000000-0000-0000-0000-000000000000

# Commerce API database configuration. DATABASE_URL is server-only and must
# never use the PUBLIC_ prefix. Render services should use the internal URL.
DATABASE_URL=postgresql://user:password@localhost:5432/cyph1_commerce
DATABASE_SSL=false
ALLOW_DEVELOPMENT_SEED=false

# Private API controls. These values are server-only. They do not approve a
# product, retail price, tax treatment, stock level or public checkout.
COMMERCE_ENABLED=false
PAYMENT_PROVIDER=disabled
FULFILMENT_MODE=disabled
FULFILMENT_PROVIDER=disabled
# Customer HTTP exposure is independently disabled. Enabling the checkout
# route does not override COMMERCE_ENABLED; both controls must permit checkout.
CHECKOUT_HTTP_ENABLED=false
# Keep verified payment notifications available during checkout containment
# only after the customer runtime has been deliberately deployed and reviewed.
PAYMENT_WEBHOOKS_ENABLED=false
CUSTOMER_RUNTIME_ORIGIN=https://private-commerce-api.example
PRIVATE_STOREFRONT_ORIGIN=https://private-preview.example
PRIVATE_CHECKOUT_UNIT_TAX_MINOR=0
CHECKOUT_ORDER_STATUS_URL=https://private-preview.example/private-commerce/order-status
CHECKOUT_CANCELLATION_URL=https://private-preview.example/private-commerce/cancelled
PAYMENT_WEBHOOK_URL=https://private-commerce-api.example/webhooks/mollie
PAYMENT_CALLBACK_ORIGINS=https://private-preview.example,https://private-commerce-api.example
MOLLIE_API_KEY=test_replace_in_secret_store

# Protected operations staging runtime. These are server-only. Cloudflare
# Access verifies identity; application permissions remain an explicit local
# allowlist and are never accepted from browser-controlled headers.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-application-aud
OPERATIONS_ACCESS_GRANTS={"operator@example.invalid":["orders:read"]}

# Never put BREVO_API_KEY or TURNSTILE_SECRET_KEY in this file.
# Private values belong in the Cloudflare Worker's encrypted secrets.
