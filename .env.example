# These values are embedded in browser-delivered code and are not secrets.
PUBLIC_SIGNUP_API_URL=https://your-worker.workers.dev/
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Commerce remains disabled throughout pre-launch. This public flag controls
# presentation only; the future commerce API must enforce its own server-side
# COMMERCE_ENABLED gate independently.
PUBLIC_COMMERCE_UI_ENABLED=false

# Commerce API database configuration. DATABASE_URL is server-only and must
# never use the PUBLIC_ prefix. Render services should use the internal URL.
DATABASE_URL=postgresql://user:password@localhost:5432/cyph1_commerce
DATABASE_SSL=false
ALLOW_DEVELOPMENT_SEED=false

# Never put BREVO_API_KEY or TURNSTILE_SECRET_KEY in this file.
# Private values belong in the Cloudflare Worker's encrypted secrets.
